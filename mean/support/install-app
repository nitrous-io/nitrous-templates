#!/usr/bin/env bash

NITROUS_APP_NAME=example
NITROUS_CODE_PATH=/home/$NITROUS_USERNAME/code
NITROUS_APP_PATH=$NITROUS_CODE_PATH/$NITROUS_APP_NAME

cd $NITROUS_CODE_PATH
# first newline: default app name
# second newline: default taskrunner to grunt
# third newline: default mean packages
echo -e '\n\n\n' | mean init -b v0.4.2
mv mean $NITROUS_APP_NAME
cd $NITROUS_APP_PATH
git reset --hard
npm install
