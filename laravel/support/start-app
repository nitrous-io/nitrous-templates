#!/bin/bash

cd /home/action/workspace/app

# create database if necessary
if ! psql -U postgres -lqt | cut -d \| -f 1 | grep -w development >/dev/null; then
  createdb $(echo $DATABASE_URL | awk '{split($0,url,"/"); print url[length(url)]}')
fi

./artisan serve --host=0.0.0.0 --port=$NITROUS_PREVIEW_PORT
