#!/usr/bin/env bash

set -e

# this is invoked with `su --preserve-environment` so need to set HOME
HOME=/home/$NITROUS_USERNAME

cd /home/$NITROUS_USERNAME/code
virtualenv -p /usr/bin/python3.4 $NITROUS_APP_NAME

cd $NITROUS_APP_PATH
source bin/activate

pip install -r requirements.txt

django-admin startproject $NITROUS_APP_NAME .

# Replace DATABASES config, looks like:
# DATABASES = {
#    'default': {
#        'ENGINE': 'django.db.backends.sqlite3',
#        'NAME': os.path.join(BASE_DIR, 'db.sqlite3'),
#    }
# }
sed -i -e '/^DATABASES =/,/^}/d' $NITROUS_APP_NAME/settings.py
cat >> $NITROUS_APP_NAME/settings.py <<EOF
# Database

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.postgresql_psycopg2',
        'NAME': 'development',
        'USER': 'nitrous',
        'HOST': 'localhost',
        'PORT': '', # Set to empty string for default.
    }
}
EOF

python manage.py syncdb --noinput

echo "from django.contrib.auth.models import User; User.objects.create_superuser('myadmin', 'admin@example.com', 'adminpass')" | python manage.py shell

