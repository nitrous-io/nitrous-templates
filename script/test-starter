#!/usr/bin/env bash

# Usage: test-starter <starter directory> [manualmode]

source $(dirname "$BASH_SOURCE[0]")/helper

tname=${1:?"Please enter the name of the template to test"}
iname="quay.io/nitrous/$tname"
pvport="3000"

if ! docker history $iname >/dev/null 2>&1; then
  error "Cannot find image $iname"
  exit 1
fi

ok "running container from image $iname"
cid=$(docker run -d -p $pvport:$pvport $iname)
echo "container id: $cid"

function cleanup_container {
  ok "removing container $cid"
  docker rm -f $cid >/dev/null
  exit
}

trap cleanup_container ERR EXIT SIGHUP SIGINT SIGTERM

ok 'running start-app'
docker exec -dt $cid su --preserve-environment -l nitrous -c 'HOME=/home/nitrous bash -l -c /home/nitrous/code/example/start-app'

if [[ $2 != "" ]]; then
  read -p "Manual test mode. Hit <Enter> once finished"
  exit 0
fi

for i in `seq 1 10`; do
  sleep 3
  if curl -s http://localhost:${pvport} >/dev/null; then
    ok "curl to port $pvport successful"
    exit 0
  else
    error "curl attempt $i to port $pvport failed"
  fi
done
exit 1

# vim:ft=sh
