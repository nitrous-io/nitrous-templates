#!/usr/bin/env ruby

# run with a name and list of markdown files, in order
# outputs generated html to stdout
#
# Usage:
# ./gen-readme <body class name> <title name> <markdown file> [more markdown files]...
#
# Example:
# ./gen-readme rails Rails INTRO.md rails/README.md ruby/README.md ubuntu/README.md
#
# Requirements:
# - `go get github.com/russross/blackfriday-tool`
# - `go install github.com/russross/blackfriday-tool`

require 'erb'

css_path = 'css/style.css' # relative to repo root

template = <<-HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset='utf-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
  <title><%= title %></title>
  <style media="screen" type="text/css">
    <%= css %>
  </style>
</head>

<body class="<%= body_class %>">
  <div class="container">
    <h1><%= welcome %></h1>
    <%= body %>
  </div>
</body>
</html>
HTML

# convert runs blackfriday-tool on each file given and cats the results
# together it is the equivalent of running `blackfriday-tool <(file1 file2 # file3)`;
# looping through makes error messages more obvious
def convert(files)
  markup = ''
  files.each_with_index do |f, i|
    out = `blackfriday-tool #{f}`
    if $? != 0
      # blackfriday-tool will output errors to stderr
      err "Error running blackfriday-tool"
    end
    markup << out

    markup << "<hr>" if markup != '' && i < files.size - 1 # divider between each section
  end

  # FIXME currently opening non-https pages in README iframe will just blank scree,
  # so workaround to make sure all links open in new tab
  markup.gsub('<a href', '<a target="_blank" href')
end

def err(s)
  STDERR.puts s
  exit 1
end

if __FILE__ == $0
  if ARGV.size < 3
    err 'Usage: gen-readme <title> <file> [FILE]...'
  end

  # body_class, name, welcome, css and body used as bindings for template
  css = File.read(File.expand_path(File.join(File.dirname(__FILE__), "..", css_path)))

  body_class, name, files = ARGV[0], ARGV[1], ARGV.drop(2)
  title = "#{ name } project guide"
  welcome = "Welcome to your Nitrous #{ name } project!"

  if name.downcase == 'migrate'
    title = "Migrated Lite box"
    welcome = "Your Lite box is now a Nitrous project"
  end

  body = convert(files)
  if body.strip == ''
    err 'No output from blackfriday!'
  end

  puts ERB.new(template).result()
end
